  <worksheets>
    <worksheet name='KPI Mortality Rate'>
      <table>
        <view>
          <datasources>
            <datasource caption='oncology_data_for_tableau' name='federated.1w0m7rf1gjfh4415vrjz30sxy4jz' />
          </datasources>
          <datasource-dependencies datasource='federated.1w0m7rf1gjfh4415vrjz30sxy4jz'>
            <column caption='Mortality Rate' datatype='real' name='[Calculation_2234108009553920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [vital_status] = &quot;Dead&quot; THEN 1 ELSE 0 END) / COUNT([patient_id])' />
            </column>
            <column caption='Patient Id' datatype='string' name='[patient_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2234108009553920]' derivation='User' name='[usr:Calculation_2234108009553920:qk]' pivot='key' type='quantitative' />
            <column caption='Vital Status' datatype='string' name='[vital_status]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.1w0m7rf1gjfh4415vrjz30sxy4jz].[usr:Calculation_2234108009553920:qk]' value='p0.00%' />
